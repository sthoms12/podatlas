---
import Layout from '../../layouts/Layout.astro';
import {
  buildAmazonUrl,
  buildBookshopUrl,
  buildGoogleMapsUrl,
} from '../../config/monetization';
import { formatTime } from '../../lib/format';
import { loadAllShowsSync, slugify, type ShowSummary } from '../../lib/staticData';

export function getStaticPaths() {
  const shows = loadAllShowsSync();
  return shows.map((show) => ({
    params: { slug: show.slug },
    props: { show },
  }));
}

interface Props {
  show: ShowSummary;
}

const { show } = Astro.props;
const siteOrigin = Astro.site?.toString().replace(/\/+$/, '') || 'https://podatlas.app';
const canonicalPath = `/show/${encodeURIComponent(show.slug)}`;
const pageUrl = new URL(canonicalPath, `${siteOrigin}/`).toString();

const title = `${show.name} — Every City, Book & Place Mentioned | PodAtlas`;
const description = `Interactive index of ${show.name} on PodAtlas: ${show.episodes.length} mapped episodes across ${show.cities.map((c) => c.name).join(', ')}, plus ${show.books.length} books and ${show.placesAndGear.length} landmarks & gear with timestamps.`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'PodAtlas World Map', item: siteOrigin },
      { '@type': 'ListItem', position: 2, name: show.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: show.name,
    url: pageUrl,
    description,
  },
  ...(show.books.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: `Books Mentioned on ${show.name}`,
          numberOfItems: show.books.length,
          itemListElement: show.books.map((item, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            item: {
              '@type': 'Book',
              name: item.book.title,
              author: { '@type': 'Person', name: item.book.author },
              ...(item.book.isbn ? { isbn: item.book.isbn } : {}),
            },
          })),
        },
      ]
    : []),
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <div class="min-h-dvh bg-[#faf9f6] text-stone-900">
    <header class="border-b border-stone-200/80 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-2 font-serif text-lg font-semibold text-stone-900 hover:text-sky-700 transition">
          <span>PodAtlas</span>
        </a>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-stone-900 text-white hover:bg-sky-700 text-xs font-semibold transition"
        >
          <span>Open 3D Globe</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
      <section class="bg-white rounded-3xl border border-stone-200/90 p-6 sm:p-8 shadow-2xs">
        <div class="text-xs font-semibold uppercase tracking-widest text-sky-700">
          Podcast Show Index
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-stone-900 tracking-tight mt-2">
          {show.name}
        </h1>
        <p class="text-stone-600 mt-3 max-w-2xl leading-relaxed text-[15px]">
          Every destination, book, restaurant, and landmark extracted from <strong>{show.name}</strong>—mapped
          to the PodAtlas 3D globe with exact audio timestamps.
        </p>

        <div class="flex flex-wrap items-center gap-2 mt-5 text-xs">
          {
            show.categories.map((cat) => (
              <span class="px-3 py-1 rounded-full bg-stone-100 text-stone-700 font-medium">{cat}</span>
            ))
          }
          <span class="px-3 py-1 rounded-full bg-sky-50 text-sky-800 font-medium">
            {show.cities.length} {show.cities.length === 1 ? 'City' : 'Cities'} Mapped
          </span>
          <span class="px-3 py-1 rounded-full bg-amber-50 text-amber-900 font-medium">
            {show.books.length} Books
          </span>
          <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-900 font-medium">
            {show.placesAndGear.length} Places &amp; Gear
          </span>
        </div>
      </section>

      <!-- Cities Covered -->
      <section class="space-y-3">
        <h2 class="font-serif text-2xl font-semibold text-stone-900">
          Cities Covered by {show.name}
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            show.cities.map((c) => (
              <a
                href={`/city/${encodeURIComponent(c.id)}`}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white border border-stone-200 hover:border-sky-500 hover:text-sky-700 text-sm font-medium transition"
              >
                <span>{c.name}</span>
                <span class="text-xs text-stone-400">{c.country}</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Indexed Episodes -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl font-semibold text-stone-900">
          Mapped Episodes ({show.episodes.length})
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            show.episodes.map(({ cityId, cityName, episode }) => (
              <article class="p-5 rounded-2xl bg-white border border-stone-200/90 flex flex-col justify-between gap-3">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs text-stone-500">
                    <a href={`/city/${encodeURIComponent(cityId)}`} class="font-semibold text-sky-700 hover:underline">
                      {cityName}
                    </a>
                    <span class="font-mono">{formatTime(episode.durationSec)}</span>
                  </div>
                  <h3 class="font-serif text-lg font-semibold text-stone-900 mt-1">{episode.title}</h3>
                  <p class="text-xs text-stone-600 mt-2 leading-relaxed">{episode.summary}</p>
                </div>
                <div class="pt-2 border-t border-stone-100 text-xs">
                  <a
                    href={`/city/${encodeURIComponent(cityId)}`}
                    class="font-semibold text-stone-900 hover:text-sky-700 transition"
                  >
                    Open interactive player &amp; mentions →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Books Mentioned -->
      {
        show.books.length > 0 && (
          <section class="space-y-4">
            <h2 class="font-serif text-2xl font-semibold text-stone-900">
              Books Mentioned on {show.name}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {show.books.map(({ cityId, cityName, book }) => (
                <article class="p-5 rounded-2xl bg-white border border-stone-200/90 flex flex-col justify-between gap-3">
                  <div>
                    <div class="text-[11px] font-medium text-stone-500">
                      Featured in{' '}
                      <a href={`/city/${encodeURIComponent(cityId)}`} class="text-sky-700 hover:underline">
                        {cityName}
                      </a>
                    </div>
                    <h3 class="font-serif text-lg font-semibold text-stone-900 mt-1">{book.title}</h3>
                    <div class="text-xs text-stone-500">by {book.author}</div>
                    {book.quote && (
                      <blockquote class="text-xs text-stone-600 italic mt-2 pl-3 border-l-2 border-amber-300">
                        “{book.quote}”
                      </blockquote>
                    )}
                  </div>
                  <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-stone-100 text-xs">
                    <a
                      href={buildBookshopUrl(book)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="px-3 py-1.5 rounded-lg bg-stone-900 text-white hover:bg-sky-700 font-medium transition"
                    >
                      Bookshop.org
                    </a>
                    <a
                      href={buildAmazonUrl(`${book.title} ${book.author}`)}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="px-3 py-1.5 rounded-lg bg-stone-100 text-stone-800 hover:bg-stone-200 font-medium transition"
                    >
                      Amazon
                    </a>
                    <span class="ml-auto font-mono text-stone-400">{formatTime(book.timestampSec)}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- Places & Gear -->
      {
        show.placesAndGear.length > 0 && (
          <section class="space-y-4">
            <h2 class="font-serif text-2xl font-semibold text-stone-900">
              Places &amp; Gear Mentioned on {show.name}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {show.placesAndGear.map(({ cityName, place }) => (
                <div class="p-4 rounded-2xl bg-white border border-stone-200/90 flex flex-col justify-between gap-2">
                  <div>
                    <div class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">
                      {place.type} · {cityName}
                    </div>
                    <h3 class="font-semibold text-sm text-stone-900 mt-0.5">{place.name}</h3>
                    <p class="text-xs text-stone-600 mt-1 leading-relaxed">{place.note}</p>
                  </div>
                  <div class="pt-2 border-t border-stone-100 text-[11px] font-medium">
                    {place.type === 'Gear' ? (
                      <a
                        href={buildAmazonUrl(place.name)}
                        target="_blank"
                        rel="noopener noreferrer sponsored"
                        class="text-sky-700 hover:underline"
                      >
                        View on Amazon →
                      </a>
                    ) : (
                      <a
                        href={buildGoogleMapsUrl(place, cityName)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sky-700 hover:underline"
                      >
                        Open in Google Maps →
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <footer class="pt-4 border-t border-stone-200/80 text-xs text-stone-500 flex flex-wrap items-center justify-between gap-2">
        <span>
          Explore countries:{' '}
          {
            Array.from(new Set(show.cities.map((c) => c.country))).map((countryName, idx) => (
              <>
                {idx > 0 && ', '}
                <a href={`/country/${encodeURIComponent(slugify(countryName))}`} class="text-sky-700 hover:underline">
                  {countryName}
                </a>
              </>
            ))
          }
        </span>
        <a href="/" class="hover:text-stone-900">← Back to PodAtlas Globe</a>
      </footer>
    </main>
  </div>
</Layout>
