---
import { ClientRouter } from 'astro:transitions';
import '../index.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  rssUrl?: string;
  rssTitle?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonicalPath, rssUrl, rssTitle, jsonLd } = Astro.props;
const siteOrigin = Astro.site?.toString().replace(/\/+$/, '') || 'https://podatlas.app';
const resolvedPath = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = new URL(resolvedPath, `${siteOrigin}/`).toString();
const fullRssUrl = rssUrl ? new URL(rssUrl, `${siteOrigin}/`).toString() : null;
const ogImageUrl = `${siteOrigin}/og-image.jpg`;
const jsonLdEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="PodAtlas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PodAtlas — Interactive 3D Podcast World Map" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      fullRssUrl && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssTitle ?? title}
          href={fullRssUrl}
        />
      )
    }
    {
      jsonLdEntries.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="bg-[#faf9f6] text-stone-900 antialiased selection:bg-sky-200/70 selection:text-stone-900">
    <slot />
  </body>
</html>
