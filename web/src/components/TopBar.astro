---
import { CATEGORY_COLORS } from '../lib/format';
import type { Category } from '../types/podatlas';

const categories: readonly ('All' | Category)[] = ['All', 'Travel', 'History', 'Food', 'Culture'];
---

<header
  transition:persist="podatlas-topbar"
  class="shrink-0 border-b border-stone-200/90 bg-white/95 backdrop-blur px-3.5 md:px-5 py-2.5 md:py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-2.5 md:gap-3 z-30"
>
  <!-- Top Row on Mobile: Brand + Search -->
  <div class="flex items-center gap-3 flex-1 min-w-0">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <div
        class="w-8 h-8 md:w-9 md:h-9 rounded-xl bg-stone-900 text-[#faf9f6] flex items-center justify-center shadow-xs group-hover:bg-sky-700 transition"
      >
        <svg
          class="w-4 h-4 md:w-4.5 md:h-4.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20"></path>
          <path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path>
        </svg>
      </div>
      <div>
        <span class="font-serif font-semibold text-base md:text-lg text-stone-900 leading-none tracking-tight block">
          PodAtlas
        </span>
        <p class="hidden sm:block text-[11.5px] text-stone-500 leading-tight mt-0.5">
          Podcasts, books &amp; places by city
        </p>
      </div>
    </a>

    <!-- Instant Search -->
    <div id="podatlas-search-box" class="relative flex-1 min-w-0 md:max-w-md md:mx-auto">
      <svg
        class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="podatlas-search-input"
        type="text"
        autocomplete="off"
        placeholder="Search cities, books..."
        class="w-full pl-9 pr-8 py-1.5 md:py-2 text-base sm:text-[13px] rounded-xl bg-stone-100/90 border border-stone-200/80 text-stone-900 placeholder:text-stone-400 focus:outline-none focus:bg-white focus:border-stone-400 focus:ring-2 focus:ring-stone-200 transition"
      />
      <kbd
        id="podatlas-search-kbd"
        class="hidden md:inline-flex items-center justify-center absolute right-2.5 top-1/2 -translate-y-1/2 px-1.5 py-0.5 text-[10px] font-mono text-stone-400 bg-white border border-stone-200 rounded pointer-events-none"
      >
        /
      </kbd>
      <button
        id="podatlas-search-clear"
        type="button"
        aria-label="Clear search"
        class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-700 text-base leading-none cursor-pointer p-1"
      >
        &times;
      </button>
      <div
        id="podatlas-search-dropdown"
        class="hidden absolute left-0 right-0 top-full mt-1.5 rounded-xl bg-white border border-stone-200 shadow-xl z-50 max-h-72 overflow-y-auto custom-scroll"
      >
      </div>
    </div>
  </div>

  <!-- Color-Coded Category Filters (horizontal scroll on mobile, wrap on desktop) -->
  <div
    id="podatlas-category-bar"
    class="flex items-center gap-1.5 flex-nowrap overflow-x-auto no-scrollbar md:flex-wrap md:overflow-visible shrink-0 -mx-0.5 px-0.5"
  >
    {
      categories.map((cat) => {
        const dotColor = cat === 'All' ? null : CATEGORY_COLORS[cat];
        return (
          <button
            type="button"
            data-cat={cat}
            class={`cat-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium border transition cursor-pointer ${
              cat === 'All'
                ? 'bg-stone-900 text-white border-stone-900 shadow-2xs'
                : 'bg-white text-stone-700 border-stone-200 hover:bg-stone-100 hover:border-stone-300'
            }`}
          >
            {dotColor && (
              <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background-color: ${dotColor};`}
                aria-hidden="true"
              />
            )}
            <span>{cat}</span>
          </button>
        );
      })
    }
  </div>
</header>
