---
import type { CitiesGeoJSON } from '../types/podatlas';

interface Props {
  geoJson: CitiesGeoJSON;
  selectedCityId: string;
  hideOnMobileDefault?: boolean;
}

const { geoJson, hideOnMobileDefault = false } = Astro.props;
const features = geoJson.features;
const totalEps = features.reduce((sum, f) => sum + f.properties.episodeCount, 0);
---

<main
  id="podatlas-map-pane"
  transition:persist="podatlas-map"
  class={`${hideOnMobileDefault ? 'hidden md:block' : 'block'} relative flex-1 min-w-0 min-h-0 bg-gradient-to-b from-[#d8e4f0] via-[#e8eff6] to-[#f3f0e9] overflow-hidden`}
>
  <div id="podatlas-map-canvas" class="w-full h-full"></div>

  <!-- Unified Floating Guide + Surprise Me Pill (safe width on mobile) -->
  <div
    class="absolute top-3 left-3 max-w-[calc(100%-4.5rem)] flex items-center gap-2 pl-3 pr-1.5 py-1.5 rounded-full bg-white/95 backdrop-blur border border-stone-200/90 text-xs text-stone-700 shadow-sm z-10"
  >
    <span class="hidden lg:inline font-medium text-stone-900 shrink-0">Spin &amp; click any pin</span>
    <span class="hidden lg:inline text-stone-300 shrink-0">·</span>
    <span id="podatlas-stats-label" class="text-stone-500 truncate">
      {features.length} cities · {totalEps} episodes
    </span>
    <span class="h-3.5 w-px bg-stone-200 shrink-0" aria-hidden="true"></span>
    <button
      id="podatlas-surprise-btn"
      data-surprise-trigger
      type="button"
      title="Fly to a random destination (Shortcut: R)"
      class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-stone-100 hover:bg-stone-900 text-stone-800 hover:text-white font-semibold transition cursor-pointer"
    >
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="16 3 21 3 21 8"></polyline>
        <line x1="4" y1="20" x2="21" y2="3"></line>
        <polyline points="21 16 21 21 16 21"></polyline>
        <line x1="15" y1="15" x2="21" y2="21"></line>
        <line x1="4" y1="4" x2="9" y2="9"></line>
      </svg>
      <span>Surprise</span>
      <span class="hidden sm:inline">me</span>
    </button>
  </div>

  <!-- Map Controls (Zoom, Reset, Globe/Flat Toggle) -->
  <div class="absolute top-3 right-3 flex flex-col gap-1.5 z-10">
    <button
      id="podatlas-zoom-in"
      type="button"
      title="Zoom in"
      aria-label="Zoom in"
      class="w-9 h-9 rounded-xl bg-white/95 backdrop-blur border border-stone-200/90 text-stone-700 hover:bg-stone-100 hover:text-stone-900 flex items-center justify-center shadow-sm cursor-pointer font-semibold text-base transition"
    >
      +
    </button>
    <button
      id="podatlas-zoom-out"
      type="button"
      title="Zoom out"
      aria-label="Zoom out"
      class="w-9 h-9 rounded-xl bg-white/95 backdrop-blur border border-stone-200/90 text-stone-700 hover:bg-stone-100 hover:text-stone-900 flex items-center justify-center shadow-sm cursor-pointer font-semibold text-base transition"
    >
      &minus;
    </button>
    <button
      id="podatlas-zoom-reset"
      type="button"
      title="Reset world view"
      aria-label="Reset world view"
      class="w-9 h-9 rounded-xl bg-white/95 backdrop-blur border border-stone-200/90 text-stone-700 hover:bg-stone-100 hover:text-stone-900 flex items-center justify-center shadow-sm cursor-pointer transition"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg>
    </button>
    <button
      id="podatlas-projection-toggle"
      type="button"
      title="Switch to flat map"
      aria-label="Toggle 3D globe and flat map"
      aria-pressed="true"
      class="w-9 h-9 rounded-xl bg-stone-900 text-white border border-stone-900 hover:bg-stone-800 flex items-center justify-center shadow-sm cursor-pointer transition"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path
          d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Story Map Mode Floating Pill (visible when playing an episode with geocoded stops) -->
  <div
    id="podatlas-story-pill"
    class="hidden absolute top-14 left-3 max-w-[calc(100%-4.5rem)] items-center gap-2 pl-3 pr-1.5 py-1.5 rounded-full bg-stone-900/95 backdrop-blur border border-stone-700 text-xs text-white shadow-md z-10"
  >
    <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0" aria-hidden="true"></span>
    <span id="podatlas-story-pill-label" class="font-medium truncate">Story Map · 0 stops</span>
    <span class="h-3.5 w-px bg-stone-700 shrink-0" aria-hidden="true"></span>
    <button
      id="podatlas-exit-story-btn"
      type="button"
      class="shrink-0 px-2.5 py-0.5 rounded-full bg-stone-800 hover:bg-stone-700 text-stone-200 hover:text-white font-semibold transition cursor-pointer"
    >
      World view
    </button>
  </div>

  <!-- Subtle Flight Arrival Toast -->
  <div
    id="podatlas-flight-toast"
    aria-live="polite"
    class="pointer-events-none opacity-0 translate-y-2 transition-all duration-300 absolute bottom-5 left-1/2 -translate-x-1/2 z-20 px-4 py-2 rounded-full bg-stone-900/92 backdrop-blur text-white text-xs font-medium shadow-lg flex items-center gap-2 whitespace-nowrap"
  >
    <span class="text-sky-400" aria-hidden="true">✈</span>
    <span id="podatlas-flight-toast-text">Flying to destination...</span>
  </div>
</main>
