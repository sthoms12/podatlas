---
import type { CitiesGeoJSON } from '../types/podatlas';

interface Props {
  geoJson: CitiesGeoJSON;
  selectedCityId: string;
}

const { geoJson, selectedCityId } = Astro.props;
const features = geoJson.features;
const totalEps = features.reduce((sum, f) => sum + f.properties.episodeCount, 0);
const totalBooks = features.reduce((sum, f) => sum + f.properties.bookCount, 0);
const totalPlaces = features.reduce((sum, f) => sum + f.properties.placeCount, 0);
---

<main
  transition:persist="podatlas-map"
  class="relative flex-1 min-w-0 bg-slate-950 overflow-hidden"
>
  <div id="podatlas-map-canvas" class="w-full h-full"></div>

  <!-- Floating Stats Pill -->
  <div
    class="absolute top-3 left-3 flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/90 backdrop-blur border border-slate-700/80 text-xs text-slate-200 shadow-lg pointer-events-none"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span id="podatlas-stats-label" class="font-medium">
      {features.length} Cities · {totalEps} Episodes · {totalBooks} Books · {totalPlaces} Places
    </span>
  </div>

  <!-- Map Controls -->
  <div class="absolute top-3 right-3 flex flex-col gap-1.5">
    <button
      id="podatlas-zoom-in"
      type="button"
      title="Zoom in"
      class="w-8 h-8 rounded-lg bg-slate-900/90 backdrop-blur border border-slate-700 text-slate-100 hover:bg-slate-800 flex items-center justify-center shadow-md cursor-pointer font-semibold text-sm"
    >
      +
    </button>
    <button
      id="podatlas-zoom-out"
      type="button"
      title="Zoom out"
      class="w-8 h-8 rounded-lg bg-slate-900/90 backdrop-blur border border-slate-700 text-slate-100 hover:bg-slate-800 flex items-center justify-center shadow-md cursor-pointer font-semibold text-sm"
    >
      &minus;
    </button>
    <button
      id="podatlas-zoom-reset"
      type="button"
      title="Reset world view"
      class="w-8 h-8 rounded-lg bg-slate-900/90 backdrop-blur border border-slate-700 text-slate-100 hover:bg-slate-800 flex items-center justify-center shadow-md cursor-pointer"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg>
    </button>
  </div>

  <!-- Bottom Quick-Jump City Strip -->
  <div
    class="absolute bottom-3 left-3 right-3 flex items-center gap-1.5 overflow-x-auto custom-scroll pb-1"
  >
    <span
      class="shrink-0 text-xs text-slate-300 bg-slate-900/90 backdrop-blur px-2.5 py-1 rounded-full border border-slate-700/80"
    >
      Explore:
    </span>
    <div id="podatlas-city-pills" class="flex items-center gap-1.5">
      {
        features.map((feat) => {
          const p = feat.properties;
          const active = p.id === selectedCityId;
          return (
            <a
              href={`/city/${encodeURIComponent(p.id)}`}
              data-city-pill={p.id}
              data-categories={p.categories.join(',')}
              data-primary-cat={p.primaryCategory}
              class={`city-pill shrink-0 px-2.5 py-1 rounded-full text-xs font-medium border transition ${
                active
                  ? 'bg-sky-500 text-slate-950 border-sky-400 shadow-sm'
                  : 'bg-slate-900/90 backdrop-blur text-slate-200 border-slate-700/80 hover:bg-slate-800'
              }`}
            >
              {p.name}
            </a>
          );
        })
      }
    </div>
  </div>
</main>
