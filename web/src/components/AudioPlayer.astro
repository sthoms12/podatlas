---
---

<footer
  transition:persist="podatlas-player"
  class="shrink-0 border-t border-slate-800 bg-slate-900/95 backdrop-blur px-4 py-2.5 flex items-center gap-4 z-30"
>
  <audio id="podatlas-audio-el"></audio>

  <div class="flex items-center gap-2.5 min-w-0 w-52 sm:w-64 shrink-0">
    <button
      id="podatlas-play-pause"
      type="button"
      title="Play / Pause"
      class="w-9 h-9 rounded-full bg-sky-500 text-slate-950 flex items-center justify-center shrink-0 hover:bg-sky-400 transition shadow-sm cursor-pointer"
    >
      <svg id="podatlas-icon-play" class="w-4 h-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg id="podatlas-icon-pause" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>
    <div class="min-w-0">
      <div id="podatlas-player-title" class="text-xs font-semibold text-slate-100 truncate">
        Select an episode to listen
      </div>
      <div id="podatlas-player-show" class="text-[11px] text-slate-400 truncate">
        Direct RSS audio streaming · $0 hosting
      </div>
    </div>
  </div>

  <!-- Scrubber & Clickable Mention Markers -->
  <div class="flex-1 flex flex-col gap-1 min-w-0">
    <div class="flex items-center gap-2.5">
      <span
        id="podatlas-player-current"
        class="text-[11px] font-mono tabular-nums text-slate-400 w-10 text-right"
      >
        00:00
      </span>
      <div class="relative flex-1 h-5 flex items-center">
        <input
          id="podatlas-player-scrubber"
          type="range"
          min="0"
          max="2880"
          value="0"
          aria-label="Episode timeline"
          class="w-full accent-sky-400 cursor-pointer h-1.5"
        />
        <div
          id="podatlas-mention-markers"
          class="absolute inset-x-0 top-1/2 -translate-y-1/2 pointer-events-none h-2.5"
        >
        </div>
      </div>
      <span
        id="podatlas-player-duration"
        class="text-[11px] font-mono tabular-nums text-slate-400 w-10"
      >
        48:00
      </span>
    </div>
    <div id="podatlas-player-hint" class="text-[11px] text-slate-400 truncate pl-12">
      Click any timestamp badge in Episodes, Books, or Places to jump straight to that mention.
    </div>
  </div>

  <div class="hidden md:flex items-center gap-1.5 shrink-0">
    <button
      id="podatlas-skip-back"
      type="button"
      class="px-2 py-1 rounded-md text-xs bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer"
    >
      -15s
    </button>
    <button
      id="podatlas-skip-fwd"
      type="button"
      class="px-2 py-1 rounded-md text-xs bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer"
    >
      +30s
    </button>
    <button
      id="podatlas-speed-btn"
      type="button"
      title="Playback speed"
      class="px-2 py-1 rounded-md text-xs font-mono bg-slate-800 text-sky-300 hover:bg-slate-700 cursor-pointer min-w-[44px]"
    >
      1x
    </button>
  </div>
</footer>
