---
---

<footer
  id="podatlas-player-bar"
  transition:persist="podatlas-player"
  class="hidden shrink-0 border-t border-stone-200 bg-white/95 backdrop-blur px-3.5 sm:px-5 pt-2.5 sm:py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 z-30 shadow-[0_-4px_20px_rgba(28,25,23,0.06)]"
>
  <audio id="podatlas-audio-el"></audio>

  <!-- Row 1 on Mobile (Left section on Desktop): Play/Pause + Info + Mobile Close -->
  <div class="flex items-center justify-between gap-2.5 min-w-0 sm:w-64 lg:w-72 shrink-0">
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <button
        id="podatlas-play-pause"
        type="button"
        title="Play / Pause"
        aria-label="Play or pause"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-stone-900 text-white flex items-center justify-center shrink-0 hover:bg-sky-700 transition shadow-xs cursor-pointer"
      >
        <svg id="podatlas-icon-play" class="w-4 h-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg id="podatlas-icon-pause" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="currentColor">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
      </button>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1.5 min-w-0">
          <span
            id="podatlas-eq-bars"
            class="hidden shrink-0 inline-flex items-end gap-[2px] h-3 w-3"
            aria-hidden="true"
          >
            <span class="eq-bar w-[2.5px] h-full rounded-full bg-sky-600"></span>
            <span class="eq-bar w-[2.5px] h-full rounded-full bg-sky-600"></span>
            <span class="eq-bar w-[2.5px] h-full rounded-full bg-sky-600"></span>
          </span>
          <div id="podatlas-player-title" class="text-[13px] font-semibold text-stone-900 truncate">
            Select an episode to listen
          </div>
        </div>
        <div id="podatlas-player-show" class="text-xs text-stone-500 truncate">
          PodAtlas
        </div>
      </div>
    </div>

    <!-- Mobile-only speed + close controls on Row 1 -->
    <div class="flex sm:hidden items-center gap-1 shrink-0">
      <button
        data-player-speed-btn
        type="button"
        title="Playback speed"
        class="px-2 py-1 rounded-lg text-xs font-mono font-medium bg-stone-100 text-stone-800 hover:bg-stone-200 transition cursor-pointer min-w-[40px] text-center"
      >
        1x
      </button>
      <button
        data-player-close-btn
        type="button"
        title="Close player"
        aria-label="Close player"
        class="w-8 h-8 rounded-lg text-stone-400 hover:text-stone-800 hover:bg-stone-100 flex items-center justify-center transition cursor-pointer text-lg leading-none"
      >
        &times;
      </button>
    </div>
  </div>

  <!-- Row 2 on Mobile (Center section on Desktop): Full-Width Scrubber & Live Mention -->
  <div class="flex-1 flex flex-col gap-1 min-w-0">
    <div class="flex items-center gap-2">
      <span
        id="podatlas-player-current"
        class="text-[11px] font-mono tabular-nums text-stone-500 w-9 sm:w-10 text-right shrink-0"
      >
        00:00
      </span>
      <div class="relative flex-1 h-6 sm:h-5 flex items-center">
        <input
          id="podatlas-player-scrubber"
          type="range"
          min="0"
          max="100"
          value="0"
          aria-label="Episode timeline"
          class="w-full accent-stone-900 cursor-pointer h-1.5"
        />
        <div
          id="podatlas-mention-markers"
          class="absolute inset-x-0 top-1/2 -translate-y-1/2 pointer-events-none h-2.5"
        >
        </div>
      </div>
      <span
        id="podatlas-player-duration"
        class="text-[11px] font-mono tabular-nums text-stone-500 w-9 sm:w-10 shrink-0"
      >
        00:00
      </span>
    </div>
    <div id="podatlas-player-hint" class="text-[11.5px] text-stone-500 truncate sm:pl-12">
      Click any amber marker on the timeline to jump to a mention.
    </div>
  </div>

  <!-- Desktop right controls -->
  <div class="hidden sm:flex items-center gap-1.5 shrink-0">
    <button
      id="podatlas-skip-back"
      type="button"
      class="hidden md:inline-flex px-2.5 py-1.5 rounded-lg text-xs font-medium bg-stone-100 text-stone-700 hover:bg-stone-200 transition cursor-pointer"
    >
      -15s
    </button>
    <button
      id="podatlas-skip-fwd"
      type="button"
      class="hidden md:inline-flex px-2.5 py-1.5 rounded-lg text-xs font-medium bg-stone-100 text-stone-700 hover:bg-stone-200 transition cursor-pointer"
    >
      +30s
    </button>
    <button
      data-player-speed-btn
      type="button"
      title="Playback speed"
      class="inline-flex px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium bg-stone-100 text-stone-800 hover:bg-stone-200 transition cursor-pointer min-w-[44px] justify-center"
    >
      1x
    </button>
    <button
      data-player-close-btn
      type="button"
      title="Close player"
      aria-label="Close player"
      class="w-8 h-8 rounded-lg text-stone-400 hover:text-stone-800 hover:bg-stone-100 flex items-center justify-center transition cursor-pointer text-lg leading-none"
    >
      &times;
    </button>
  </div>
</footer>
