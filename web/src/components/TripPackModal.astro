---
import type { CityData } from '../types/podatlas';
import { MONETIZATION_CONFIG } from '../config/monetization';

interface Props {
  city: CityData;
}

const { city } = Astro.props;
---

<div
  id="podatlas-trip-modal"
  class="hidden fixed inset-0 z-50 bg-black/65 backdrop-blur-xs flex items-center justify-center p-4"
>
  <div
    id="podatlas-trip-modal-card"
    class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-5 shadow-2xl space-y-4"
  >
    <div class="flex items-start justify-between gap-3">
      <div>
        <span
          class="text-[11px] font-medium px-2 py-0.5 rounded bg-sky-500/15 text-sky-300 border border-sky-500/30"
        >
          Offline Flight Bundle
        </span>
        <h3 class="text-base font-semibold text-slate-100 mt-1.5">
          {city.name} Trip Audio &amp; Reading Pack
        </h3>
      </div>
      <button
        id="podatlas-close-trip-modal"
        type="button"
        aria-label="Close modal"
        class="text-slate-400 hover:text-slate-100 text-lg leading-none cursor-pointer"
      >
        &times;
      </button>
    </div>

    <p class="text-xs text-slate-300 leading-relaxed">
      One-time <strong class="text-slate-100">$7</strong> export for travelers prepping for a flight
      — generated cleanly from PodAtlas&apos;s static city index with zero server cost:
    </p>

    <ul class="space-y-2 text-xs text-slate-200">
      <li class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>
          <strong>{city.episodes.length} curated podcast episodes</strong> queued as an offline OPML
          playlist
        </span>
      </li>
      <li class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>
          <strong>{city.books.length} pre-trip books</strong> with exact episode quotes &amp;
          timestamps
        </span>
      </li>
      <li class="flex items-center gap-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>
          <strong>{city.placesAndGear.length} pinned restaurants, landmarks &amp; gear</strong>
          ready for Google Maps
        </span>
      </li>
    </ul>

    <div class="flex flex-col gap-2 pt-1">
      {
        MONETIZATION_CONFIG.stripeTripPackUrl && (
          <a
            href={MONETIZATION_CONFIG.stripeTripPackUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2 px-3 rounded-lg text-xs font-semibold bg-sky-500 text-slate-950 hover:bg-sky-400 transition text-center"
          >
            Unlock Full $7 Trip Pack ↗
          </a>
        )
      }
      <div class="grid grid-cols-2 gap-2">
        <button
          id="podatlas-download-txt"
          type="button"
          class="py-2 px-3 rounded-lg text-xs font-medium bg-slate-800 text-slate-100 hover:bg-slate-700 transition cursor-pointer"
        >
          Sample Itinerary (.txt)
        </button>
        <button
          id="podatlas-download-opml"
          type="button"
          class="py-2 px-3 rounded-lg text-xs font-medium bg-slate-800 text-slate-100 hover:bg-slate-700 transition cursor-pointer"
        >
          Podcast OPML (.opml)
        </button>
      </div>
    </div>
  </div>
</div>
