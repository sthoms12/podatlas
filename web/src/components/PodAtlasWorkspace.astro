---
import Layout from '../layouts/Layout.astro';
import TopBar from './TopBar.astro';
import WorldMap from './WorldMap.astro';
import CityDrawer from './CityDrawer.astro';
import WelcomeDrawer from './WelcomeDrawer.astro';
import AudioPlayer from './AudioPlayer.astro';
import TripPackModal from './TripPackModal.astro';
import type { CitiesGeoJSON, CityData } from '../types/podatlas';

interface Props {
  city: CityData;
  geoJson: CitiesGeoJSON;
  mode?: 'welcome' | 'city';
  pageTitle?: string;
}

const { city, geoJson, mode = 'city', pageTitle } = Astro.props;
const isWelcome = mode === 'welcome';
const siteOrigin = Astro.site?.toString().replace(/\/+$/, '') || 'https://podatlas.app';
const canonicalPath = isWelcome ? '/' : `/city/${encodeURIComponent(city.id)}`;
const pageUrl = new URL(canonicalPath, `${siteOrigin}/`).toString();

const title =
  pageTitle ??
  (isWelcome
    ? 'PodAtlas — Interactive Podcast World Map, Travel & History Podcasts'
    : `Best Podcasts & Books About ${city.name}, ${city.country} — Audio Map & Guide | PodAtlas`);
const description = isWelcome
  ? 'Interactive 3D Podcast World Map: pick any city to stream curated travel, history, food & culture podcasts with every book, restaurant, and landmark linked to its exact timestamp.'
  : `Listen to ${city.episodes.length} curated podcasts about ${city.name}, ${city.country}, plus ${city.books.length} mentioned books, ${city.placesAndGear.length} landmarks & gear, an interactive Story Map, and free RSS/KML trip exports. ${city.tagline}`;

const jsonLd: Record<string, unknown>[] = isWelcome
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'PodAtlas',
        url: siteOrigin,
        description,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'PodAtlas',
        url: siteOrigin,
        applicationCategory: 'TravelApplication',
        operatingSystem: 'Web',
        description,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
      },
    ]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'PodAtlas World Map',
            item: siteOrigin,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: `${city.name}, ${city.country}`,
            item: pageUrl,
          },
        ],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'TouristDestination',
        name: `${city.name}, ${city.country}`,
        description: city.tagline,
        url: pageUrl,
        geo: {
          '@type': 'GeoCoordinates',
          latitude: city.lat,
          longitude: city.lon,
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: `Podcasts About ${city.name}, ${city.country}`,
        numberOfItems: city.episodes.length,
        itemListElement: city.episodes.map((ep, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          item: {
            '@type': 'PodcastEpisode',
            name: ep.title,
            description: ep.summary,
            datePublished: ep.publishedAt,
            partOfSeries: {
              '@type': 'PodcastSeries',
              name: ep.show,
            },
            ...(ep.audioUrl
              ? {
                  associatedMedia: {
                    '@type': 'AudioObject',
                    contentUrl: ep.audioUrl,
                  },
                }
              : {}),
          },
        })),
      },
      ...(city.books.length > 0
        ? [
            {
              '@context': 'https://schema.org',
              '@type': 'ItemList',
              name: `Books Mentioned on Podcasts About ${city.name}`,
              numberOfItems: city.books.length,
              itemListElement: city.books.map((book, idx) => ({
                '@type': 'ListItem',
                position: idx + 1,
                item: {
                  '@type': 'Book',
                  name: book.title,
                  author: {
                    '@type': 'Person',
                    name: book.author,
                  },
                  ...(book.isbn ? { isbn: book.isbn } : {}),
                },
              })),
            },
          ]
        : []),
    ];
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  rssUrl={isWelcome ? undefined : `/feeds/${encodeURIComponent(city.id)}.xml`}
  rssTitle={isWelcome ? undefined : `${city.name} Podcasts — PodAtlas RSS`}
  jsonLd={jsonLd}
>
  <div class="h-dvh flex flex-col bg-[#faf9f6] text-stone-900 overflow-hidden">
    <TopBar />

    <!-- Mobile View Toggle (3D Globe vs Overview / City Guide) -->
    <div
      id="podatlas-mobile-toggle"
      data-default-mobile-view="drawer"
      class="md:hidden shrink-0 px-3.5 py-2 bg-white border-b border-stone-200 flex items-center gap-2"
    >
      <button
        type="button"
        data-mobile-view="map"
        class="flex-1 py-2 px-2 rounded-lg text-xs truncate transition cursor-pointer font-medium bg-stone-100 text-stone-700"
      >
        3D Globe
      </button>
      <button
        type="button"
        data-mobile-view="drawer"
        class="flex-1 py-2 px-2 rounded-lg text-xs truncate transition cursor-pointer font-semibold bg-stone-900 text-white"
      >
        {isWelcome ? 'Overview' : `${city.name} Guide`}
      </button>
    </div>

    <div class="flex-1 flex flex-col md:flex-row min-h-0 overflow-hidden">
      <WorldMap
        geoJson={geoJson}
        selectedCityId={isWelcome ? '' : city.id}
        hideOnMobileDefault={true}
      />
      {isWelcome ? <WelcomeDrawer geoJson={geoJson} demoCity={city} /> : <CityDrawer city={city} />}
    </div>

    <AudioPlayer />
  </div>

  {!isWelcome && <TripPackModal city={city} />}

  <!-- Embedded city payload for instant client-side audio playback (or live mention demo on /) -->
  <script id="podatlas-city-payload" type="application/json" set:html={JSON.stringify(city)} />
  <script>
    import '../scripts/client';
  </script>
</Layout>
