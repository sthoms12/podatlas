<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>PodAtlas Pins — Mexico City, Mexico</name>
    <description>Aztec canals beneath leafy Art Deco neighborhoods and the greatest street-food capital in the Americas.</description>
    <Placemark>
      <name>El Vilsito</name>
      <description>[Food] Working mechanic garage by day that transforms into a legendary al pastor stand at night. (Proof (America’s Test Kitchen) @ 13:00)</description>
      <Point>
        <coordinates>-99.1597,19.3976,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Templo Mayor</name>
      <description>[Landmark] Excavated Aztec pyramid sitting directly beside the Zócalo cathedral. (99% Invisible @ 17:00)</description>
      <Point>
        <coordinates>-99.1313,19.435,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>
